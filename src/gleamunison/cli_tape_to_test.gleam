//// `gleamunison tape-to-test <file.lisp> <def> <tape.json>` — turn a
//// recorded effect transcript into a permanent regression test. The
//// generated file re-states the subject definitions, adds a mock handler
//// that pins the recorded args and result (the mock itself asserts the
//// args via Test.expect, so a changed prompt/call fails the suite), and a
//// test_ def asserting the recorded final value. Capture what the run
//// actually did; pin it as tomorrow's test.
////
//// v1 limits (honest by construction): single-op tapes only; Int and Text
//// args/results only (the tape stores Erlang inspect reprs, and only those
//// two shapes round-trip into surface literals). Multi-op sequences need a
//// cursor — future work.

import gleam/int
import gleam/io
import gleam/list
import gleam/string
import gleamunison/bootstraps
import gleamunison/compile
import gleamunison/repl_eval
import gleamunison/transcript
import simplifile

pub fn command(args: List(String)) -> Nil {
  case args {
    [path, name, tape_path] ->
      case simplifile.read(tape_path) {
        Error(e) ->
          io.println("tape-to-test: cannot read tape: " <> string.inspect(e))
        Ok(json) ->
          case generate(path, name, json) {
            Error(err) -> io.println("tape-to-test: " <> err)
            Ok(source) -> {
              let out = "test_" <> name <> "_tape.lisp"
              case simplifile.write(source, to: out) {
                Ok(_) -> io.println("tape-to-test: wrote " <> out)
                Error(e) ->
                  io.println(
                    "tape-to-test: write failed: " <> string.inspect(e),
                  )
              }
            }
          }
      }
    _ ->
      io.println(
        "usage: gleam run -- tape-to-test <file.lisp> <def> <tape.json>",
      )
  }
}

/// Generate the regression test source. Reads the subject file (defs are
/// restated verbatim so the generated file stands alone), parses the tape,
/// and emits mock + test defs.
pub fn generate(
  subject_path: String,
  def_name: String,
  tape_json: String,
) -> Result(String, String) {
  use tape <- result_try(transcript.from_json(tape_json))
  let entries = transcript.tape_entries(tape)
  use entry <- result_try(case entries {
    [] -> Error("tape has no recorded ops")
    [single] -> Ok(single)
    _ ->
      Error(
        "tape has "
        <> int.to_string(list.length(entries))
        <> " ops; v1 supports single-op tapes only",
      )
  })
  use subject <- result_try(case simplifile.read(subject_path) {
    Ok(t) -> Ok(t)
    Error(e) -> Error("cannot read subject: " <> string.inspect(e))
  })
  use ability_name <- result_try(ability_name_for_key(entry.ability))
  use args_lit <- result_try(repr_to_literal(entry.args_repr))
  use result_lit <- result_try(repr_to_literal(entry.result_repr))
  Ok(render(
    source: subject,
    def_name:,
    ability: ability_name,
    entry:,
    args_lit:,
    result_lit:,
  ))
}

/// The tape stores the ability's module key (m_<hash-suffix>), not its
/// surface name. Map back through the bootstrap ability table; an ability
/// outside it is an honest error, never a guess.
pub fn ability_name_for_key(key: String) -> Result(String, String) {
  let abilities =
    list.filter_map(bootstraps.get_init_defs_data(), fn(d) {
      case d {
        bootstraps.BAbility(name, _) -> Ok(name)
        _ -> Error(Nil)
      }
    })
  case
    list.find(abilities, fn(name) {
      compile.module_name_for(repl_eval.ref_for_name(name)) == key
    })
  {
    Ok(name) -> Ok(name)
    Error(_) ->
      Error(
        "tape ability key "
        <> key
        <> " is not a bootstrap ability; declare it in the file first (v1 limit)",
      )
  }
}

fn render(
  source subject: String,
  def_name def_name: String,
  ability ability: String,
  entry entry: transcript.OpRecord,
  args_lit args_lit: String,
  result_lit result_lit: String,
) -> String {
  subject
  <> "\n\n;; ── generated by tape-to-test: do not edit by hand ──\n"
  <> ";; tape: "
  <> ability
  <> " op "
  <> int.to_string(entry.op)
  <> " (seq "
  <> int.to_string(entry.seq)
  <> ")\n\n"
  <> "(define tape_mock\n"
  <> "  (lam val\n"
  <> "    (lam cont\n"
  <> "      (let _ (do Test expect (eq? val "
  <> args_lit
  <> "))\n"
  <> "        (cont "
  <> result_lit
  <> ")))))\n\n"
  <> "(define test_"
  <> def_name
  <> "_tape\n"
  <> "  (do Test expect\n"
  <> "    (eq? (handle "
  <> def_name
  <> " tape_mock "
  <> ability
  <> ") "
  <> result_lit
  <> ")))\n"
}

/// Erlang inspect repr → gleamunison surface literal. v1 grammar: text
/// (`<<"hi">>` → `"hi"`), integers, and lists of the same. Anything else is
/// an honest error, never a guess.
pub fn repr_to_literal(repr: String) -> Result(String, String) {
  let trimmed = string.trim(repr)
  case trimmed {
    "\"" <> _ ->
      case string.ends_with(trimmed, "\"") && string.length(trimmed) >= 2 {
        // Gleam inspect of a Text value is already a valid surface literal.
        True -> Ok(trimmed)
        False -> Error("unterminated text repr: " <> repr)
      }
    "<<\"" <> rest ->
      case string.ends_with(rest, ">>") {
        // Erlang-format tape: `hi">>` — keep the content, restore quotes.
        True -> Ok("\"" <> string.drop_end(rest, 2))
        False -> Error("unterminated text repr: " <> repr)
      }
    "[" <> _ -> list_repr(trimmed)
    _ ->
      case int.parse(trimmed) {
        Ok(_) -> Ok(trimmed)
        Error(_) -> Error("unsupported repr (v1: Int and Text only): " <> repr)
      }
  }
}

fn list_repr(repr: String) -> Result(String, String) {
  case string.starts_with(repr, "[") && string.ends_with(repr, "]") {
    False -> Error("malformed list repr: " <> repr)
    True -> {
      let inner = string.slice(repr, 1, string.length(repr) - 2)
      case string.trim(inner) {
        "" -> Ok("(list)")
        _ -> {
          use parts <- result_try(split_top_level(inner, [], ""))
          use lits <- result_try(
            list.try_map(parts, fn(p) { repr_to_literal(p) }),
          )
          Ok("(list " <> string.join(lits, " ") <> ")")
        }
      }
    }
  }
}

/// Split a repr list body on commas (v1: flat lists of scalars — no nested
/// lists inside, those error out via repr_to_literal on the parts).
fn split_top_level(
  s: String,
  acc: List(String),
  current: String,
) -> Result(List(String), String) {
  case string.pop_grapheme(s) {
    Error(_) ->
      case string.trim(current) {
        "" ->
          case acc {
            [] -> Ok([])
            _ -> Ok(list.reverse(acc))
          }
        c -> Ok(list.reverse([c, ..acc]))
      }
    Ok(#(",", rest)) -> split_top_level(rest, [string.trim(current), ..acc], "")
    Ok(#(g, rest)) -> split_top_level(rest, acc, current <> g)
  }
}

fn result_try(
  r: Result(a, String),
  f: fn(a) -> Result(b, String),
) -> Result(b, String) {
  case r {
    Ok(v) -> f(v)
    Error(e) -> Error(e)
  }
}
